<meta property="og:type" content="website">
<meta property="og:title" content="Showcase — Built with Boring Stack">
<meta property="og:description" content="Real products running on Go, SQLite, Litestream, Caddy and a $5 VPS — with what they actually cost to run and one lesson each.">
<meta property="og:url" content="https://boringstack.org/showcase.html">
<meta property="og:image" content="https://boringstack.org/og-image.png">
