<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{.Title}} — Boring Stack</title>
<meta name="description" content="{{.Summary}}">
<link rel="canonical" href="https://boringstack.org/issues/{{.Slug}}.html">
{{if .Draft}}<meta name="newsletter-draft" content="true">{{end}}
<meta name="theme-color" content="#0a0a0a">
<link rel="icon" type="image/x-icon" href="../favicon.ico">
<link rel="icon" type="image/png" sizes="32x32" href="../favicon-32x32.png">
<link rel="icon" type="image/png" sizes="192x192" href="../favicon-192x192.png">
<link rel="apple-touch-icon" sizes="180x180" href="../apple-touch-icon.png">

<meta property="og:type" content="article">
<meta property="og:title" content="{{.Title}}">
<meta property="og:description" content="{{.Summary}}">
<meta property="og:url" content="https://boringstack.org/issues/{{.Slug}}.html">
<meta property="og:image" content="https://boringstack.org/og-image.png">
<meta property="article:published_time" content="{{.DateISO}}">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="../style.css">
<link rel="alternate" type="application/rss+xml" title="Boring Stack Weekly" href="../feed.xml">
</head>
<body>

<nav class="topbar" aria-label="primary">
  <span class="nameplate"><a href="../"><img src="../favicon-32x32.png" alt="" width="22" height="22">Boring Stack</a></span>
  <span class="links">
    <a href="../manifesto.html">manifesto</a>
    <a href="./">issues</a>
    <a href="../#newsletter">newsletter</a>
    <a href="https://github.com/boringstackoverflow/boring-stack">github</a>
  </span>
</nav>

<article id="newsletter-body" class="issue">
  <p class="issue-meta">{{.DateHuman}} · issue #{{.Number}}</p>
  <h1>{{.Title}}</h1>
  {{.HTMLBody}}
</article>

<footer>
  <span><a href="./">← all issues</a> · <a href="../#newsletter">subscribe</a></span>
  <span><a href="https://x.com/boringstack">@boringstack</a> / 2026 / MIT / <a href="mailto:hello@boringstack.org">hello@boringstack.org</a></span>
</footer>

<noscript><img src="https://api.boringstack.org/v1/px.gif?p=/issues" alt="" width="1" height="1" style="position:absolute"></noscript>
<script src="../analytics.js"></script>

</body>
</html>
